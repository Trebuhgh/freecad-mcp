{
  "name": "freecad-mcp",
  "version": "1.0.0",
  "description": "MCP Server for FreeCAD parametric 3D CAD modeling — 165 tools for document management, primitives, booleans, sketching, meshing, FEM, BIM, and more",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "freecad-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test tests/*.test.mjs",
    "start": "node dist/index.js",
    "dev": "tsc && node dist/index.js",
    "audit": "npm audit"
  },
  "keywords": [
    "mcp",
    "freecad",
    "cad",
    "3d-modeling",
    "parametric",
    "step",
    "stl",
    "model-context-protocol",
    "mesh",
    "fem",
    "bim"
  ],
  "author": "Dan Stan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sergiudanstan/freecad-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/sergiudanstan/freecad-mcp/issues"
  },
  "homepage": "https://github.com/sergiudanstan/freecad-mcp#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0"
  }
}
